diff --git a/sdk/platform/opxy-1.2.1/tape_reels.cpp b/sdk/platform/opxy-1.2.1/tape_reels.cpp
new file mode 100644
index 0000000..67b63c9
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/tape_reels.cpp
@@ -0,0 +1,84 @@
+// Gira las bobinas de la pantalla de cinta (tape.svg) mientras suena: con el
+// transporte en marcha o con una tecla de la cinta pulsada. Se engancha a la
+// llamada de la pantalla a su dibujo (0x8d51fe1c), así que corre en la GUI, solo
+// con la cinta en pantalla. Un SVG sin nodos reel_* se dibuja como siempre.
+// Los potes 1 y 2 (x1..x10 y 50..200 %) marcan la velocidad de giro.
+#include <opxy/draw.hpp>
+#include "screen.hpp"
+
+namespace {
+using namespace opxy;
+using namespace opxy::platform;
+
+const char* const kIds[] = {"reel_l0", "reel_l1", "reel_l2", "reel_l3",
+                            "reel_r0", "reel_r1", "reel_r2", "reel_r3"};
+const u32 kNodes = sizeof(kIds) / sizeof(kIds[0]);
+const u32 kLeftPerMicrosecond = 1432;   // 2^32 / 3e6: una vuelta cada 3 s a x1 y 100 %
+const u32 kRightPerMicrosecond = 2864;  // la derecha, el doble de rápida
+const u32 kBaseSpeed = 100;             // x1 y 100 %
+const u32 kMaxSpeed = 1200;             // una vuelta cada 0,25 s: más rápido se vería al revés
+const u32 kMaxStep = 100000;            // tras una pausa larga no da un salto
+
+screen::PathNode* nodes[kNodes];
+const void* bound_page;
+const void* bound_svg;
+u32 last_time, left_phase, right_phase;
+
+void bind(screen::Base* o) {
+    if (bound_page == o && bound_svg == o->svg) return;
+    for (u32 i = 0; i < kNodes; ++i) nodes[i] = screen::path_node(screen::find(o, kIds[i]));
+    bound_page = o;
+    bound_svg = o->svg;
+}
+
+// Gira en sentido antihorario las cuatro piezas de una bobina.
+void turn_reel(u32 first, u32 phase) {
+    const draw::Turn turn = draw::rotation(static_cast<i32>((phase >> 16) * 3600 >> 16));
+    const u32 at[4] = {0, 1, 3, 4};
+    const i32 value[4] = {turn.cos, -turn.sin, turn.sin, turn.cos};
+    for (u32 i = first; i < first + kNodes / 2; ++i)
+        if (nodes[i]) screen::set_words(&nodes[i]->leaf, at, value);
+}
+
+// Velocidad (x por %) con los valores que muestra la pantalla de serie (8d56b3cc, 8d56b430).
+u32 reel_speed() {
+    const screen::Parameters* p = screen::parameters(selected_track());
+    if (!p || p->end < p->begin + 8) return kBaseSpeed;
+    const i32* words = reinterpret_cast<const i32*>(p->begin);
+    if (words[0] < 0 || words[1] < 0) return kBaseSpeed;
+    const u32 times = ((static_cast<u32>(words[0]) >> 8) * 10 >> 23) + 1;
+    const u32 scaled = (static_cast<u32>(words[1]) >> 8) * 201;
+    const u32 percent = (scaled >> 23) < 100 ? (scaled >> 24) + 50 : scaled >> 23;
+    const u32 speed = times * percent;
+    return speed < kMaxSpeed ? speed : kMaxSpeed;
+}
+
+// n * speed / 100 sin división (41 / 4096 = 1 / 99,9).
+u32 scaled_rate(u32 per_microsecond, u32 speed) { return per_microsecond * speed * 41 >> 12; }
+
+bool sounding() {
+    if (byte(kPlaying) || byte(kPlaying + 1)) return true;
+    // La misma lectura con la que la pantalla de serie marca la tecla sonando.
+    const u32 note = stock<u32()>(0x8d4d6eb0)() & 0xff;
+    return stock<u32(u32, u32)>(0x8d5b7d10)(selected_track(), note) != 0;
+}
+}  // namespace
+
+extern "C" void sdk_tape_draw(screen::Base* o, u32 argument) __asm__("sdk_tape_draw");
+extern "C" void sdk_tape_draw(screen::Base* o, u32 argument) {
+    if (o->svg) {
+        bind(o);
+        u32 clock[2];  // el reloj de serie escribe 64 bits en microsegundos
+        stock<void(u32*)>(0x8d5be3a0)(clock);
+        const u32 step = clock[0] - last_time;
+        last_time = clock[0];
+        if (sounding() && step < kMaxStep) {
+            const u32 speed = reel_speed();
+            left_phase += step * scaled_rate(kLeftPerMicrosecond, speed);
+            right_phase += step * scaled_rate(kRightPerMicrosecond, speed);
+            turn_reel(0, left_phase);
+            turn_reel(kNodes / 2, right_phase);
+        }
+    }
+    stock<void(screen::Base*, u32)>(0x8d51fe1c)(o, argument);
+}
